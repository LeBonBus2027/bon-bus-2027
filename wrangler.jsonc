// Hébergement Cloudflare (Workers, fichiers statiques seulement : aucun script côté serveur).
// Les en-têtes de sécurité viennent de public/_headers, copié dans dist au build.
{
  "name": "bon-bus-2027",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "./dist" },
  // Aucune collecte : pas de journaux ni de traces des visites côté Cloudflare.
  "observability": { "enabled": false },
  "workers_dev": true,
  // Pas d'adresse de prévisualisation publique (essai-…workers.dev) : seul le site de production est servi.
  "preview_urls": false
}
